rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // 신규 문서 생성 — 본인인증 완료 시
      allow create: if request.auth != null
        && request.auth.uid == uid;

      // 기존 문서 수정 — uid, provider, createdAt 변경 불가
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'provider', 'createdAt']);

      // users/{uid}/searchHistory/{historyId}
      match /searchHistory/{historyId} {
        allow read, create, delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }

    // clubs/{clubId}
    match /clubs/{clubId} {
      allow read: if resource.data.isActive == true;

      allow write: if request.auth != null
        && request.auth.token.admin == true;

      // clubs/{clubId}/info/{infoId}
      match /info/{infoId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.token.admin == true;
      }

      // clubs/{clubId}/menus/{menuId}
      match /menus/{menuId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.token.admin == true;
      }

      // clubs/{clubId}/photos/{photoId}
      match /photos/{photoId} {
        allow read: if true;

        // 생성: 로그인 유저, 본인 userId로만
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;

        // 삭제: 본인 또는 어드민
        allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
      }

      // clubs/{clubId}/reviews/{reviewId}
      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;

        allow update: if request.auth != null
          && resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['userId', 'clubId', 'createdAt']);

        allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
      }
    }

    // 컬렉션 그룹: reviews — 마이페이지 '내 리뷰 관리'의 크로스-클럽 조회용.
    // collectionGroup 쿼리에는 중첩 match 규칙이 적용되지 않으므로 별도 허용.
    // 본인 리뷰 읽기만 허용 (쓰기는 기존 clubs/.../reviews 규칙으로만).
    match /{path=**}/reviews/{reviewId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // banners/{bannerId}
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // vybeRecommendations/{recId} — vybe 추천 페이지 큐레이션
    match /vybeRecommendations/{recId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // performances/{performanceId} — 장르 페이지 공연 일정
    match /performances/{performanceId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // notices/{noticeId} — 공지사항. 작성/수정은 어드민 페이지 전용, 앱은 읽기만.
    // 목록 쿼리가 isActive==true 로 필터하므로 resource 기반 read 규칙과 맞물린다.
    match /notices/{noticeId} {
      allow read: if resource.data.isActive == true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // searchLogs/{logId} — 검색 트렌드 집계용 원본 로그.
    // 클라는 쓰기만, 읽기는 Admin SDK(집계 함수) 전용.
    match /searchLogs/{logId} {
      allow read: if false;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keyword is string
        && request.resource.data.keyword.size() >= 2
        && request.resource.data.keyword.size() <= 30
        && request.resource.data.keys()
            .hasOnly(['keyword', 'userId', 'source', 'createdAt', 'expireAt']);

      allow update, delete: if false;
    }

    // searchTrends/{docId} — 집계 스냅샷(current) + 큐레이션 백업(fallback)
    match /searchTrends/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // searchHashtags/{tagId} — 인기 해시태그 큐레이션
    match /searchHashtags/{tagId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // favorites/{favoriteId}
    match /favorites/{favoriteId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
