# Flutter 앱 키 (프로젝트 루트 .env) — 값 없이 키 이름만 커밋한다.
# Cloud Functions 키는 functions/.env.example 참고 (별도 파일).
#
# ⚠ 네이버 '로그인' clientId/clientSecret 은 여기 없다 —
#   네이티브 설정에 들어간다 (android/app/src/main/AndroidManifest.xml 의
#   com.naver.sdk.* 메타데이터 · ios/Runner/Info.plist). dotenv 로는 안 읽는다.

KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here
NAVER_MAP_CLIENT_ID=your_naver_map_client_id_here
ALGOLIA_APP_ID=your_algolia_app_id_here
ALGOLIA_SEARCH_API_KEY=your_algolia_search_only_key_here
